---
// The site header's content, shared by the standalone pages and Starlight.
// It lists only destinations that exist.
import Mark from './Mark.astro';
---

<div class="site-nav">
  <a class="home" href="/" translate="no">
    <Mark />
    <span>Kyro</span>
  </a>
  <nav aria-label="Site">
    <a href="/generator/">Generator</a>
    <a href="https://github.com/kyro-pxe/kyro">GitHub</a>
  </nav>
</div>

<style>
  .site-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    min-height: 4.5rem;
  }

  .home {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 2.75rem;
    color: var(--strong);
    font-size: 1.375rem;
    font-weight: 800;
    font-stretch: 116%;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  nav {
    display: flex;
    gap: var(--space-2) var(--space-5);
  }

  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--text);
    font-size: 1rem;
    font-weight: 550;
    text-decoration: none;
  }

  nav a:hover,
  .home:hover {
    color: var(--accent);
  }
</style>
