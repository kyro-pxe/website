---
// A status in the roadmap's vocabulary: a marker and always the word.
import '../styles/state.css';
import { statusLabel, type Status } from '../data/status';

interface Props {
  state: Status;
  /** Render as a framed notice instead of inline. */
  block?: boolean;
}

const { state, block = false } = Astro.props;
const Tag = block ? 'p' : 'span';
---

<Tag class:list={['status', { 'status-block': block }]}>
  <span class="status-mark state-shape" data-state={state} aria-hidden="true"></span>
  <strong>{statusLabel[state]}.</strong>
  {Astro.slots.has('default') && <span class="status-text"><slot /></span>}
</Tag>

<style>
  .status strong {
    color: var(--strong);
    font-weight: 650;
  }

  .status-text {
    margin-inline-start: 0.2em;
  }

  .status-block {
    max-width: var(--measure);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--line);
    border-radius: var(--radius-control);
    background: var(--surface);
    font-size: 0.9375rem;
  }

  .status-mark {
    display: inline-block;
    width: 0.7em;
    height: 0.7em;
    margin-inline-end: 0.55em;
  }
</style>
