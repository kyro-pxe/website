---
// Reserved address for the autounattend.xml generator. The generator is not
// built yet; this page only says so. The design is in docs/adr/.
import BaseLayout from '../layouts/BaseLayout.astro';
import Status from '../components/Status.astro';
---

<BaseLayout
  title="autounattend.xml generator | Kyro"
  description="Reserved for a browser-based generator for Windows autounattend.xml files. It is not built yet."
>
  <div class="prose">
    <h1>autounattend.xml generator</h1>
    <Status state="planned" block>Nothing on this page can be used yet.</Status>
    <p>
      This address is reserved for a form that creates Windows answer files
      (<code>autounattend.xml</code>) for use with Kyro. It is meant to run in the browser only,
      without sending what you enter to any server.
    </p>
    <p>
      The planned options and the rules for turning them into XML are written down as a proposal:{' '}
      <a href="https://github.com/kyro-pxe/website/blob/main/docs/adr/0001-generator-options.md">ADR 0001, generator option set</a>.
    </p>
  </div>
</BaseLayout>
