---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found | Kyro"
  description="The requested page does not exist on this site."
  noindex
>
  <div class="frame"><div class="plain">
    <h1>Page not found</h1>
    <p>
      This address does not match any page. The site is still being written, so the page may not
      exist yet.
    </p>
    <p><a class="button button-outline" href="/">Go to the start page</a></p>
  </div></div>
</BaseLayout>
